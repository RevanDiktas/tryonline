# TryOn Backend Environment Variables
# ====================================
# Copy this to .env and fill in your values

# App Settings
DEBUG=true
API_VERSION=v1

# Supabase (use SERVICE ROLE key for backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# JWT Secret (Project Settings → API → JWT Secret) — required for checkout-profile API
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Redis (for Celery background jobs)
REDIS_URL=redis://localhost:6379/0

# RunPod (leave empty to use mock service). Same API key; one ID per serverless endpoint.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_HEATMAP_ENDPOINT_ID=

# Storage bucket names
PHOTOS_BUCKET=photos
AVATARS_BUCKET=avatars

# Server (Railway/Render set PORT automatically; default 8000 for local)
PORT=8000

# CORS: comma-separated allowed origins (e.g. your Vercel frontend)
# Example: https://app.yourdomain.com,https://yourapp.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Shopify (Tryon app — client_id ec47b40d60204a8d7cf80aa50e313d19)
# Use the same Client secret for both; get from Partner Dashboard → Tryon → API credentials.
SHOPIFY_CLIENT_ID=ec47b40d60204a8d7cf80aa50e313d19
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
