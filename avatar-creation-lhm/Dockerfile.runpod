# LHM serverless image for RunPod
# ================================
# Phase 0 build: clone aigc3d/LHM, install all Python deps via install_cu121.sh
# equivalent commands, bake in LHM-MINI + prior model + motion video. Larger
# model variants (LHM-500M-HF, LHM-1B-HF) are downloaded on demand by handler.
#
# Base: official PyTorch 2.3.0 + CUDA 12.1 image. LHM's install_cu121.sh pins
# torch==2.3.0 + xformers==0.0.26.post1 against the cu121 PyTorch index, so
# starting from a matching base avoids the pip torch reinstall step.
#
# Build time estimate: 25-35 min (most of it CUDA-extension compiles for
# pytorch3d, diff-gaussian-rasterization, simple-knn, sam2). Image size ~12 GB
# with LHM-MINI baked in. RunPod auto-build from GitHub push should fit inside
# its 60-min build budget.

FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel

# ----------------------------------------------------------------------------
# Cache-bust. BUMP THIS VALUE ON EVERY PUSH to feature/lhm.
#
# Why this exists: RunPod's BuildKit content-addressed registry caches an
# entry per layer-digest. If a build is killed mid-export (e.g. by the 30-min
# build cap), the partial upload leaves a metadata entry that promises the
# layer's digest but never finishes committing the blob. Subsequent clean
# rebuilds deterministically re-derive the same digest from the same
# instructions, try to upload to the same poisoned ref, and get rejected with
# `FailedPrecondition: unexpected commit digest`.
#
# Putting the CACHEBUST ARG immediately after FROM forces every layer
# downstream to have a different parent in its hash, so we cannot collide
# with any pre-existing poisoned ref name. The RUN line that writes the
# value to disk is what actually mutates the layer content; ARG alone is
# not enough because BuildKit doesn't fold default ARG values into the
# downstream layer hash unless they are observed by a RUN.
#
# Standing rule: bump this timestamp on every push, even for empty commits.
# Build is fully clean as a side effect, which gives us unambiguous logs.
# ----------------------------------------------------------------------------
ARG CACHEBUST=2026-05-20T23:30:00-strip-deca-and-splat
RUN echo "$CACHEBUST" > /tmp/.cachebust

# ----------------------------------------------------------------------------
# System packages
# ----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        wget \
        aria2 \
        curl \
        ca-certificates \
        ffmpeg \
        build-essential \
        ninja-build \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ----------------------------------------------------------------------------
# Workdir + clone LHM. Pinned SHA: upstream `--depth 1 main` is non-deterministic
# and has shipped at least one breaking change (SMPLXOutput __init__ missing
# 'ratio' in the pose_estimator fallback path) under our nose. Pin to the
# 2026-03-17 "release new features" commit, which is what tryonline-lhm has
# been building against since 2026-05-17.
# ----------------------------------------------------------------------------
ARG LHM_SHA=4f88aaeb3629249fbbddb4d0784a06962d9e1338
WORKDIR /workspace
RUN git clone https://github.com/aigc3d/LHM.git /workspace/LHM \
    && cd /workspace/LHM \
    && git checkout "$LHM_SHA" \
    && git log -1 --oneline
WORKDIR /workspace/LHM

# ----------------------------------------------------------------------------
# CUDA arch list for extension builds.
#
# Why this is required: RunPod's image-build farm runs on CPU-only hosts. When
# PyTorch's setup helpers try to auto-detect which compute capabilities to
# compile for, they enumerate the visible GPUs, find zero, and the resulting
# empty list crashes in cpp_extension.py:1987 with
#   `arch_list[-1] += '+PTX'`  -> IndexError: list index out of range
# Setting TORCH_CUDA_ARCH_LIST explicitly bypasses the auto-detect path.
# FORCE_CUDA=1 makes setup scripts that gate on torch.cuda.is_available() (which
# is False at build time) still build their CUDA kernels.
#
# Arch coverage:
#   8.0  = A100
#   8.6  = A6000, RTX 3090, RTX 3080
#   8.9  = RTX 4090, RTX 4080, L40, L40S
#   +PTX = JIT-compile fallback for any newer arch (H100/Blackwell)
# Add 7.5 if we ever need to run on T4. Each extra arch increases compile time.
# ----------------------------------------------------------------------------
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9+PTX"
ENV FORCE_CUDA=1

# ----------------------------------------------------------------------------
# Python deps (mirror of install_cu121.sh, with torch reinstall skipped because
# the base image already has torch 2.3.0 + cu121)
# ----------------------------------------------------------------------------
RUN pip install --no-cache-dir -U xformers==0.0.26.post1 \
        --index-url https://download.pytorch.org/whl/cu121

# rembg's PyPI package no longer bundles onnxruntime; it must be requested via
# extras. We use the GPU variant since this whole image targets CUDA workers.
# Without this, `import rembg` crashes with `ModuleNotFoundError: onnxruntime`
# at the smoke-test step (and on every runtime invocation).
RUN pip install --no-cache-dir "rembg[gpu]"

RUN pip install --no-cache-dir -r requirements.txt

# basicsr conflicts with torchvision; rebuild from source
RUN pip uninstall basicsr -y \
    && pip install --no-cache-dir git+https://github.com/XPixelGroup/BasicSR

# Heavy CUDA-extension compiles. pytorch3d is still needed for Multi-HMR's
# SMPL-X ops + DINOv2 attention paths used by PoseEstimator.
#
# sam2 / diff-gaussian / simple-knn were dropped 2026-05-20: they are only
# imported by LHM's splat decoder (HumanLRMInferrer + ModelHumanLRM +
# gs_renderer), which we no longer use. We now import PoseEstimator and
# FaceDetector standalone from engine.pose_estimation / LHM.utils, both of
# which only need torch + torchvision + einops + roma. Saves ~10-13 min
# of build time and keeps every fresh build inside RunPod's 30-min cap.
RUN pip install --no-cache-dir "git+https://github.com/facebookresearch/pytorch3d.git"

# ----------------------------------------------------------------------------
# RunPod + handler deps
# ----------------------------------------------------------------------------
RUN pip install --no-cache-dir \
        runpod \
        httpx \
        Pillow \
        huggingface_hub

# ----------------------------------------------------------------------------
# DECA stack DROPPED 2026-05-20. Realistic-face mapping via DECA was parked.
# Old layers (chumpy, face-alignment, kornia, yacs, fvcore, scikit-image,
# smplx-deca clone, SMPL-X<->FLAME correspondence wget) added ~8 min to the
# build and were only used by _deca_face_pass / _get_deca. Their build-time
# cost broke the 30-min cap (see build c84b884 killed at 1800s exact).
# Handler now produces the 4DHumans-equivalent SMPL-X bundle without DECA:
# body_apose.obj + body_tpose.obj + avatar_textured.glb (face-median skin) +
# skin_texture.png + measurements.json + smplx_params.npz.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# SMPL-Anthropometry (DavidBoja/SMPL-Anthropometry). Same package the
# 4DHumans pipeline uses to extract ~40 anthropometric measurements (chest /
# waist / hips / inseam / arm length etc.) from an SMPL-X mesh. We vendor
# the local copy (already in the repo at avatar-creation-measurements/) so
# we ship the exact code path 4DHumans has been validated against.
#
# Two patches:
#   1. The upstream class hardcodes ext="pkl" but LHM only bakes .npz models.
#      sed-swap to ext="npz".
#   2. The class loads `data/smplx/SMPLX_<GENDER>.npz` relative to its own
#      cwd; handler symlinks LHM's baked smplx dir in at runtime (idempotent
#      across worker restarts).
# ----------------------------------------------------------------------------
COPY avatar-creation-measurements /workspace/anthropometry
RUN sed -i 's/ext="pkl"/ext="npz"/g; s/ext='\''pkl'\''/ext='\''npz'\''/g' \
        /workspace/anthropometry/measure.py \
        /workspace/anthropometry/joint_definitions.py \
    && echo "patched SMPL-Anthropometry source to ext=npz"

# Smoke: confirm the package imports under the numpy.bool/int shim. We do
# NOT construct MeasureSMPLX() here because that needs SMPLX_NEUTRAL.npz
# which lives next to LHM-MINI (downloaded a few layers earlier in the
# next RUN block) — handler symlinks it at first call.
RUN python -c "import numpy as np; \
np.float = getattr(np, 'float', float); \
np.int = getattr(np, 'int', int); \
np.bool = getattr(np, 'bool', bool); \
import sys; sys.path.insert(0, '/workspace/anthropometry'); \
import measure as _m; import joint_definitions as _j; import landmark_definitions as _l; import measurement_definitions as _md; \
print('SMPL-Anthropometry package OK, possible measurements:', \
      len(_md.SMPLXMeasurementDefinitions().possible_measurements))"

# ----------------------------------------------------------------------------
# Bake LHM-MINI checkpoint + prior model + motion video into the image so the
# container is ready to run inference on first job. LHM-MINI is the smallest
# variant and runs on 16 GB GPUs; 500M-HF / 1B-HF can be downloaded at runtime
# via the handler's "download_model" command.
# ----------------------------------------------------------------------------
RUN python -c "from huggingface_hub import snapshot_download; \
    snapshot_download(repo_id='3DAIGC/LHM-MINI', \
        cache_dir='./pretrained_models/huggingface')"

# LHM_prior_model.tar + motion_video.tar are NOT baked into the image. Three
# build attempts proved this isn't viable inside RunPod's 30-min build cap:
#
# - Build #5 (aria2c baked, no CACHEBUST): image ~25 GB, export 20+ min, cap
#   exceeded, plus cache poisoning.
# - Build #7 (aria2c baked, with CACHEBUST): RUN steps clean in 17 min, but
#   image-layer write was 648s = 10.8 min on its own and cache export then
#   I/O-errored before the 30-min cap. Image was ~30 GB.
#
# Image export time scales roughly linearly with image size, so anything past
# ~20 GB total is at risk of the cap. The architecture going forward is:
#
# - Image stays small (~16 GB): just LHM repo + LHM-MINI + pip deps.
# - The two Aliyun tarballs live on a RunPod Network Volume mounted at
#   /runpod-volume, populated once via the `init` command, shared by every
#   worker thereafter.
# - handler.py's `_ensure_lhm_data()` writes to the volume if mounted, with
#   symlinks from /workspace/LHM/<subdir> back into the volume so LHM finds
#   files at the paths its scripts expect. Falls back to /workspace/LHM if
#   no volume (useful for local testing, costly for serverless cold starts).
#
# aria2 stays in the apt install because handler.py shells out to aria2c
# at runtime for the same multi-connection benefit (152 MiB/s observed
# against Aliyun OSS on a CA worker).

# ----------------------------------------------------------------------------
# Build-time smoke test. Fails the build if any of the CUDA-extension wheels
# compiled but can't actually be imported, OR if the LHM repo is missing files
# the handler relies on. This catches silent breakage that would otherwise
# only surface on the first inference job (and waste a 10-min worker spin-up).
#
# Note: torch.cuda.is_available() is False here because the build host has no
# GPU. We import the modules to verify the shared libraries loaded correctly;
# actual kernel launches are deferred to runtime on the worker.
# ----------------------------------------------------------------------------
RUN python -c "import sys; \
import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda); \
import pytorch3d; print('pytorch3d', pytorch3d.__version__); \
import xformers; print('xformers', xformers.__version__); \
import rembg; print('rembg OK'); \
import runpod; print('runpod', runpod.__version__); \
import huggingface_hub; print('huggingface_hub', huggingface_hub.__version__); \
import cv2; print('cv2', cv2.__version__); \
print('DEPS SMOKE TEST PASSED')"

# Verify the LHM repo + baked artifacts are present where the handler expects.
# train_data/motion_video and pretrained_models/{sam2,sapiens,human_model_files,...}
# are NOT checked here because they live on the Network Volume; handler.py
# verifies them at runtime via marker files.
RUN test -f /workspace/LHM/inference.sh \
    && test -f /workspace/LHM/inference_mesh.sh \
    && test -d /workspace/LHM/train_data/example_imgs \
    && test -d /workspace/LHM/pretrained_models/huggingface \
    && echo "LHM REPO + BAKED ARTIFACTS SMOKE TEST PASSED"

# ----------------------------------------------------------------------------
# Copy our serverless handler last so we can iterate on it without rebuilding
# the (slow) pip+model layers above.
#
# Path is qualified because RunPod's GitHub auto-build uses the repo root as
# the build context regardless of the "Build context" field in the endpoint
# config. Keeping it relative to repo root works for both repo-root and
# subdir build contexts.
# ----------------------------------------------------------------------------
COPY avatar-creation-lhm/handler.py /workspace/LHM/handler.py

# Final sanity: handler.py parses as valid Python.
RUN python -c "import ast; ast.parse(open('/workspace/LHM/handler.py').read()); print('handler.py syntax OK')"

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace/LHM
ENV PYOPENGL_PLATFORM=egl
# Increase RunPod init timeout; default ~7 min can fall short on cold pulls of
# a 12 GB image to a fresh worker.
ENV RUNPOD_INIT_TIMEOUT=600

WORKDIR /workspace/LHM
CMD ["python", "-u", "/workspace/LHM/handler.py"]
