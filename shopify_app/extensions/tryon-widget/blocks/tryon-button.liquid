{% comment %}
  TryOn — "Try On" button app block for product pages.
  Renders a button that opens the TryOn widget in a modal iframe.
  On Add to Cart: calls Shopify /cart/add.js with the variant matching the selected size.
  Guard: never render on cart (or any non-product template) if the block appears in shared JSON.
{% endcomment %}
{% if template.name == 'product' %}
{% liquid
  assign widget_base = 'https://tryon.global'
  assign shop_domain = shop.permanent_domain
  assign product_id = product.handle
  assign variant = product.selected_or_first_available_variant
  assign variant_id = variant.id
  assign widget_url = widget_base | append: '/test-viewer.html?shop=' | append: shop_domain | append: '&product_id=' | append: product_id | append: '&variant_id=' | append: variant_id | append: '&open=1&v=23'

  assign btn_bg = block.settings.button_background
  assign btn_fg = block.settings.button_text_color
  assign btn_radius = block.settings.corner_radius | default: 6
  assign btn_pt = block.settings.padding_vertical | default: 14
  assign btn_px = block.settings.padding_horizontal | default: 24
  assign btn_fs = block.settings.font_size | default: 14
  assign align = block.settings.alignment | default: 'left'
%}

<div
  id="tryon-root-{{ block.id }}"
  class="tryon-app-block tryon-app-block--align-{{ align }}"
  {{ block.shopify_attributes }}
>
  <style>
    #tryon-root-{{ block.id }} { margin: {{ block.settings.margin_top | default: 16 }}px 0 {{ block.settings.margin_bottom | default: 16 }}px; }
    #tryon-root-{{ block.id }}.tryon-app-block--align-left { text-align: left; }
    #tryon-root-{{ block.id }}.tryon-app-block--align-center { text-align: center; }
    #tryon-root-{{ block.id }}.tryon-app-block--align-right { text-align: right; }
    #tryon-root-{{ block.id }} .tryon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      padding: {{ btn_pt }}px {{ btn_px }}px;
      background: {{ btn_bg }};
      color: {{ btn_fg }};
      border: none;
      font-size: {{ btn_fs }}px;
      font-weight: 500;
      letter-spacing: 0.05em;
      cursor: pointer;
      border-radius: {{ btn_radius }}px;
      transition: opacity 0.2s, filter 0.2s;
      max-width: 100%;
      {% if block.settings.full_width %}
      width: 100%;
      {% endif %}
    }
    #tryon-root-{{ block.id }} .tryon-btn:hover { opacity: 0.92; filter: brightness(1.05); }
  </style>

  <button type="button" class="tryon-btn" data-tryon-open aria-label="{{ block.settings.button_label | escape }}">
    {{ block.settings.button_label }}
  </button>

  <iframe
    id="tryon-frame-{{ block.id }}"
    src=""
    title="TryOn — Virtual try-on"
    data-tryon-src="{{ widget_url }}"
    loading="lazy"
    allowtransparency="true"
    style="display:none;position:fixed;inset:0;width:100%;height:100%;z-index:999999;border:none;background:transparent;"
  ></iframe>

  <script>
    (function() {
      var root = document.getElementById('tryon-root-{{ block.id }}');
      if (!root) return;
      var btn = root.querySelector('[data-tryon-open]');
      var iframe = document.getElementById('tryon-frame-{{ block.id }}');
      if (!btn || !iframe) return;
      var src = iframe.getAttribute('data-tryon-src');

      var sizeMap = {};
      {% for v in product.variants %}
        sizeMap['{{ v.option1 | downcase | strip }}'] = {{ v.id }};
      {% endfor %}
      window.__tryonSizeVariantMap = sizeMap;
      window.__tryonFallbackVariantId = {{ variant_id }};

      var SIZE_ALIASES = {xs:['xs','extra small'],s:['s','small'],m:['m','medium'],l:['l','large'],xl:['xl','extra large']};

      function resolveVariant(size) {
        var keys = SIZE_ALIASES[size] || [size];
        for (var i = 0; i < keys.length; i++) {
          if (sizeMap[keys[i]] != null) return sizeMap[keys[i]];
        }
        return window.__tryonFallbackVariantId;
      }

      function cartRoot() {
        return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      }

      function tryonAddToCart(payload) {
        var size = (payload.size || '').toLowerCase().trim();
        var vid = resolveVariant(size);
        if (!vid || isNaN(vid)) {
          console.warn('[TryOn] No variant for size "' + size + '" — map keys:', Object.keys(sizeMap).join(', '));
          return;
        }

        var sizeUp = size === 'xs' ? 'XS' : size === 'xl' ? 'XL' : size.length ? size.charAt(0).toUpperCase() + size.slice(1) : '';
        var props = { _tryon_size: size, Size: sizeUp };
        if (payload.session_id) props.tryon_session_id = payload.session_id;

        var body = { items: [{ id: Number(vid), quantity: 1, properties: props }] };

        var themeCart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        if (themeCart && typeof themeCart.getSectionsToRender === 'function') {
          try {
            var ids = themeCart.getSectionsToRender().map(function(s) { return s.id; });
            body.sections = ids.slice(0, 5).join(',');
            body.sections_url = window.location.pathname.split('?')[0];
          } catch (e) {}
        }

        console.log('[TryOn] Adding to cart:', sizeUp, '→ variant', vid);

        fetch(cartRoot() + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.items) {
            console.log('[TryOn] ✅ Added to cart:', sizeUp, '— variant', vid);
            refreshCartAfterAdd(data);
          } else {
            console.warn('[TryOn] Cart rejected (variant ' + vid + '):', data.message || data.description || JSON.stringify(data));
          }
        })
        .catch(function(err) { console.error('[TryOn] Cart add failed:', err); });
      }

      function refreshCartAfterAdd(addResp) {
        var themeCart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');

        if (themeCart && typeof themeCart.renderContents === 'function' && addResp && addResp.sections) {
          try {
            themeCart.renderContents(addResp);
            document.dispatchEvent(new CustomEvent('cart:refresh', { detail: addResp }));
            return;
          } catch (e) {}
        }

        fetch(cartRoot() + 'cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var c = String(cart.item_count);
            var sels = [
              '.cart-count-bubble span', '[data-cart-count]', '.cart-count',
              '#cart-icon-bubble span[aria-hidden]', '.cart-count-bubble',
              'span.cart-count', '.cart-drawer__count'
            ];
            sels.forEach(function(sel) {
              try { document.querySelectorAll(sel).forEach(function(el) { el.textContent = c; }); } catch (e) {}
            });
            document.dispatchEvent(new CustomEvent('cart:refresh', { detail: cart }));
            if (window.Shopify && typeof window.Shopify.onCartUpdate === 'function') window.Shopify.onCartUpdate(cart);
            var toggle = document.querySelector(
              '[data-cart-drawer-toggle], cart-drawer summary, .js-drawer-open-right, [aria-controls="cart-drawer"], .js-cart-link, a[href="/cart"]'
            );
            if (toggle) { try { toggle.click(); } catch (e) {} }
          })
          .catch(function() {});
      }

      btn.addEventListener('click', function() {
        iframe.src = src;
        iframe.style.display = 'block';
        document.body.style.overflow = 'hidden';
      });

      function close() {
        iframe.style.display = 'none';
        iframe.src = '';
        document.body.style.overflow = '';
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && iframe.style.display === 'block') close();
      });

      window.addEventListener('message', function(e) {
        if (!e.data) return;
        if (e.data.type === 'TRYON_CLOSE') {
          close();
        }
        if (e.data.type === 'TRYON_ADD_TO_CART' && e.data.payload) {
          if (!window.__tryonCartMessageBound) {
            tryonAddToCart(e.data.payload);
          }
          close();
        }
        if (e.data.type === 'TRYON_USER_ID' && e.data.user_id && iframe) {
          var base = iframe.getAttribute('data-tryon-src') || '';
          if (base) {
            var sep = base.indexOf('?') >= 0 ? '&' : '?';
            iframe.src = base + sep + 'user_id=' + encodeURIComponent(e.data.user_id);
          }
        }
      });
    })();
  </script>
</div>
{% endif %}

{% schema %}
{
  "name": "Try On",
  "target": "section",
  "javascript": "tryon-cart.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try On"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Padding top/bottom",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Padding left/right",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 16
    }
  ]
}
{% endschema %}
