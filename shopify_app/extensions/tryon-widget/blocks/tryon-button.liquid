{% comment %}
  TryOn — "Try On" button app block for product pages.
  Renders a button that opens the TryOn widget in a modal iframe.
  Widget URL: https://tryonline.vercel.app/test-viewer.html
{% endcomment %}
{% liquid
  assign widget_base = 'https://tryonline.vercel.app'
  assign shop_domain = shop.permanent_domain
  assign product_id = product.handle
  assign variant = product.selected_or_first_available_variant
  assign variant_id = variant.id
  assign widget_url = widget_base | append: '/test-viewer.html?shop=' | append: shop_domain | append: '&product_id=' | append: product_id | append: '&variant_id=' | append: variant_id | append: '&open=1&v=3'
%}

<div class="tryon-app-block" {{ block.shopify_attributes }}>
  <style>
    .tryon-app-block { margin: 1rem 0; }
    .tryon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 24px;
      background: #0a0a0a;
      color: #fff;
      border: none;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.05em;
      cursor: pointer;
      border-radius: 6px;
      transition: opacity 0.2s;
    }
    .tryon-btn:hover { opacity: 0.9; }
    .tryon-iframe {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 999999;
      border: none;
      background: transparent;
    }
    .tryon-iframe.open { display: block; }
  </style>

  <button type="button" class="tryon-btn" data-tryon-open aria-label="Try on with TryOn">
    {{ block.settings.button_label }}
  </button>

  <iframe
    class="tryon-iframe"
    id="tryon-frame-{{ block.id }}"
    src=""
    title="TryOn — Virtual try-on"
    data-tryon-src="{{ widget_url }}"
    loading="lazy"
    allowtransparency="true"
  ></iframe>

  <script>
    (function() {
      var btn = document.querySelector('[data-tryon-open]');
      var iframe = document.getElementById('tryon-frame-{{ block.id }}');
      if (!btn || !iframe) return;
      var src = iframe.getAttribute('data-tryon-src');

      btn.addEventListener('click', function() {
        iframe.src = src;
        iframe.classList.add('open');
        document.body.style.overflow = 'hidden';
      });

      function close() {
        iframe.classList.remove('open');
        document.body.style.overflow = '';
        iframe.src = '';
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && iframe.classList.contains('open')) close();
      });

      window.addEventListener('message', function(e) {
        if (e.data && (e.data.type === 'TRYON_CLOSE' || e.data.type === 'TRYON_ADD_TO_CART')) {
          close();
        }
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Try On",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try On"
    }
  ]
}
{% endschema %}
