{% comment %}
  TryOn — "Try On" button app block for product pages.
  Renders a button that opens the TryOn widget in a modal iframe.
  On Add to Cart: calls Shopify /cart/add.js with the variant matching the selected size.
  Guard: never render on cart (or any non-product template) if the block appears in shared JSON.
{% endcomment %}
{% if template.name == 'product' %}
{% liquid
  assign widget_base = 'https://tryon.global'
  assign shop_domain = shop.permanent_domain
  assign product_id = product.handle
  assign variant = product.selected_or_first_available_variant
  assign variant_id = variant.id
  assign product_name_enc = product.title | url_encode
  assign product_image_enc = product.featured_image | image_url: width: 400 | url_encode
  assign product_price_enc = product.price | money_without_currency | strip | url_encode
  assign brand_name_enc = shop.name | url_encode
  # Exact product page, so tryon.global can send a shopper back here after sign-up/onboarding.
  assign return_url_enc = shop.url | append: product.url | url_encode
  # Shopper country (ISO 3166-1 alpha-2) -> regional body-size bands. Prefer the customer's saved
  # address, fall back to the storefront's selected market/country.
  assign country_code = ''
  if customer.default_address.country_code != blank
    assign country_code = customer.default_address.country_code
  elsif localization.country.iso_code != blank
    assign country_code = localization.country.iso_code
  endif
  assign widget_url = widget_base | append: '/test-viewer.html?shop=' | append: shop_domain | append: '&product_id=' | append: product_id | append: '&variant_id=' | append: variant_id | append: '&product_name=' | append: product_name_enc | append: '&product_image=' | append: product_image_enc | append: '&product_price=' | append: product_price_enc | append: '&brand_name=' | append: brand_name_enc | append: '&country=' | append: country_code | append: '&return_url=' | append: return_url_enc | append: '&open=1&v=31'

  assign btn_bg = block.settings.button_background
  assign btn_fg = block.settings.button_text_color
  assign btn_radius = block.settings.corner_radius | default: 6
  assign btn_pt = block.settings.padding_vertical | default: 14
  assign btn_px = block.settings.padding_horizontal | default: 24
  assign btn_fs = block.settings.font_size | default: 14
  assign align = block.settings.alignment | default: 'left'
%}

<div
  id="tryon-root-{{ block.id }}"
  class="tryon-app-block tryon-app-block--align-{{ align }}"
  {{ block.shopify_attributes }}
>
  <style>
    #tryon-root-{{ block.id }} { margin: {{ block.settings.margin_top | default: 16 }}px 0 {{ block.settings.margin_bottom | default: 16 }}px; }
    #tryon-root-{{ block.id }}.tryon-app-block--align-left { text-align: left; }
    #tryon-root-{{ block.id }}.tryon-app-block--align-center { text-align: center; }
    #tryon-root-{{ block.id }}.tryon-app-block--align-right { text-align: right; }
    #tryon-root-{{ block.id }} .tryon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      padding: {{ btn_pt }}px {{ btn_px }}px;
      background: {{ btn_bg }};
      color: {{ btn_fg }};
      border: none;
      font-size: {{ btn_fs }}px;
      font-weight: 500;
      letter-spacing: 0.05em;
      cursor: pointer;
      border-radius: {{ btn_radius }}px;
      transition: opacity 0.2s, filter 0.2s;
      max-width: 100%;
      {% if block.settings.full_width %}
      width: 100%;
      {% endif %}
    }
    #tryon-root-{{ block.id }} .tryon-btn:hover { opacity: 0.92; filter: brightness(1.05); }
  </style>

  <button type="button" class="tryon-btn" data-tryon-open aria-label="{{ block.settings.button_label | escape }}">
    {{ block.settings.button_label }}
  </button>

  <iframe
    id="tryon-frame-{{ block.id }}"
    src=""
    title="TryOn — Virtual try-on"
    data-tryon-src="{{ widget_url }}"
    loading="lazy"
    allowtransparency="true"
    style="display:none;position:fixed;inset:0;width:100%;height:100%;z-index:999999;border:none;background:transparent;"
  ></iframe>

  {%- comment -%}
    Fallback close + spinner: only shown until the widget iframe answers TRYON_READY. After that
    the widget owns the single ✕, so the shopper never sees two close buttons.
  {%- endcomment -%}
  <button
    id="tryon-close-{{ block.id }}"
    type="button"
    aria-label="Close TryOn"
    style="display:none;position:fixed;top:12px;right:12px;z-index:1000000;width:40px;height:40px;border-radius:50%;border:none;background:rgba(255,255,255,0.92);color:#1a1a1a;font-size:18px;line-height:1;cursor:pointer;box-shadow:0 4px 15px rgba(0,0,0,0.15);"
  >&#x2715;</button>
  <div
    id="tryon-spinner-{{ block.id }}"
    aria-hidden="true"
    style="display:none;position:fixed;top:50%;left:50%;width:36px;height:36px;margin:-18px 0 0 -18px;z-index:999998;border-radius:50%;border:3px solid rgba(0,0,0,0.12);border-top-color:#111;animation:tryon-spin-{{ block.id }} 0.8s linear infinite;"
  ></div>
  <style>@keyframes tryon-spin-{{ block.id }} { to { transform: rotate(360deg); } }</style>

  <script>
    (function() {
      var root = document.getElementById('tryon-root-{{ block.id }}');
      if (!root) return;
      var btn = root.querySelector('[data-tryon-open]');
      var iframe = document.getElementById('tryon-frame-{{ block.id }}');
      var closeBtn = document.getElementById('tryon-close-{{ block.id }}');
      if (!btn || !iframe) return;
      var src = iframe.getAttribute('data-tryon-src');

      var sizeMap = {};
      {% for v in product.variants %}
        sizeMap['{{ v.option1 | downcase | strip }}'] = {{ v.id }};
      {% endfor %}
      window.__tryonSizeVariantMap = sizeMap;
      window.__tryonFallbackVariantId = {{ variant_id }};

      var SIZE_ALIASES = {xs:['xs','extra small'],s:['s','small'],m:['m','medium'],l:['l','large'],xl:['xl','extra large']};

      function resolveVariant(size) {
        var keys = SIZE_ALIASES[size] || [size];
        for (var i = 0; i < keys.length; i++) {
          if (sizeMap[keys[i]] != null) return sizeMap[keys[i]];
        }
        return window.__tryonFallbackVariantId;
      }

      function cartRoot() {
        return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      }

      function tryonAddToCart(payload) {
        var size = (payload.size || '').toLowerCase().trim();
        var vid = resolveVariant(size);
        if (!vid || isNaN(vid)) {
          console.warn('[TryOn] No variant for size "' + size + '" — map keys:', Object.keys(sizeMap).join(', '));
          return;
        }

        var sizeUp = size === 'xs' ? 'XS' : size === 'xl' ? 'XL' : size.length ? size.charAt(0).toUpperCase() + size.slice(1) : '';
        var props = { _tryon_size: size, Size: sizeUp };
        if (payload.session_id) props.tryon_session_id = payload.session_id;

        var body = { items: [{ id: Number(vid), quantity: 1, properties: props }] };

        var themeCart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        if (themeCart && typeof themeCart.getSectionsToRender === 'function') {
          try {
            var ids = themeCart.getSectionsToRender().map(function(s) { return s.id; });
            body.sections = ids.slice(0, 5).join(',');
            body.sections_url = window.location.pathname.split('?')[0];
          } catch (e) {}
        }

        console.log('[TryOn] Adding to cart:', sizeUp, '→ variant', vid);

        fetch(cartRoot() + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.items) {
            console.log('[TryOn] ✅ Added to cart:', sizeUp, '— variant', vid);
            refreshCartAfterAdd(data);
          } else {
            console.warn('[TryOn] Cart rejected (variant ' + vid + '):', data.message || data.description || JSON.stringify(data));
          }
        })
        .catch(function(err) { console.error('[TryOn] Cart add failed:', err); });
      }

      function refreshCartAfterAdd(addResp) {
        var themeCart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');

        if (themeCart && typeof themeCart.renderContents === 'function' && addResp && addResp.sections) {
          try {
            themeCart.renderContents(addResp);
            document.dispatchEvent(new CustomEvent('cart:refresh', { detail: addResp }));
            return;
          } catch (e) {}
        }

        fetch(cartRoot() + 'cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var c = String(cart.item_count);
            var sels = [
              '.cart-count-bubble span', '[data-cart-count]', '.cart-count',
              '#cart-icon-bubble span[aria-hidden]', '.cart-count-bubble',
              'span.cart-count', '.cart-drawer__count'
            ];
            sels.forEach(function(sel) {
              try { document.querySelectorAll(sel).forEach(function(el) { el.textContent = c; }); } catch (e) {}
            });
            document.dispatchEvent(new CustomEvent('cart:refresh', { detail: cart }));
            if (window.Shopify && typeof window.Shopify.onCartUpdate === 'function') window.Shopify.onCartUpdate(cart);
            var toggle = document.querySelector(
              '[data-cart-drawer-toggle], cart-drawer summary, .js-drawer-open-right, [aria-controls="cart-drawer"], .js-cart-link, a[href="/cart"]'
            );
            if (toggle) { try { toggle.click(); } catch (e) {} }
          })
          .catch(function() {});
      }

      var spinner = document.getElementById('tryon-spinner-{{ block.id }}');
      var widgetReady = false;
      var isOpen = false;
      var fallbackTimer = null;

      function focusWidget() {
        try { iframe.focus({ preventScroll: true }); } catch (e) {}
      }

      function postToWidget(type) {
        try { iframe.contentWindow.postMessage({ type: type }, '*'); } catch (e) {}
      }

      btn.addEventListener('click', function() {
        if (isOpen) return;
        isOpen = true;
        // Re-parent iframe + close button to <body> so position:fixed escapes any ancestor
        // with transform/filter/will-change/contain (some Shopify themes apply these on the
        // product info column, which traps fixed-position children inside the column box).
        if (iframe.parentElement !== document.body) document.body.appendChild(iframe);
        if (closeBtn && closeBtn.parentElement !== document.body) document.body.appendChild(closeBtn);
        if (spinner && spinner.parentElement !== document.body) document.body.appendChild(spinner);
        // Lazy-load src once, then keep iframe alive across open/close cycles.
        // Resetting src='' on every close destroyed the iframe's WebGL context, and
        // Chrome blocks new contexts after ~16 — testers hit "Web page caused context loss".
        if (!iframe.getAttribute('src')) {
          iframe.src = src;
        } else if (widgetReady) {
          // Widget ghosts itself on close; tell it to come back in the right state.
          postToWidget('TRYON_OPEN');
        }
        iframe.style.display = 'block';
        document.body.style.overflow = 'hidden';
        // Hand keyboard focus to the widget so Esc / Tab work inside it, but only once it's
        // loaded; before that, focus stays here so the host's Esc handler still closes.
        if (widgetReady) focusWidget();
        else armFallback();
      });

      // Until the widget answers TRYON_READY: spinner now, and after 4s the fallback ✕ so the
      // shopper is never stuck under a full-screen layer (slow network, blocked, mid-reload).
      function armFallback() {
        if (spinner) spinner.style.display = 'block';
        clearTimeout(fallbackTimer);
        fallbackTimer = setTimeout(function() {
          if (isOpen && !widgetReady && closeBtn) closeBtn.style.display = 'flex';
        }, 4000);
      }

      function close(fromWidget) {
        if (!isOpen) return;
        isOpen = false;
        clearTimeout(fallbackTimer);
        iframe.style.display = 'none';
        if (closeBtn) closeBtn.style.display = 'none';
        if (spinner) spinner.style.display = 'none';
        // Do NOT reset iframe.src — keep WebGL context alive for subsequent opens.
        document.body.style.overflow = '';
        if (!fromWidget && widgetReady) postToWidget('TRYON_HIDE');
        try { btn.focus({ preventScroll: true }); } catch (e) {}
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          close(false);
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isOpen) close(false);
      });

      window.addEventListener('message', function(e) {
        if (!e.data) return;
        var fromWidget = e.source === iframe.contentWindow;
        if (e.data.type === 'TRYON_READY' && fromWidget) {
          widgetReady = true;
          clearTimeout(fallbackTimer);
          if (closeBtn) closeBtn.style.display = 'none';
          if (spinner) spinner.style.display = 'none';
          // Sync the (re)loaded widget with the host: hidden → HIDE, shown → OPEN. A reload can
          // swallow an earlier TRYON_OPEN, and the widget ignores OPEN when already open.
          postToWidget(isOpen ? 'TRYON_OPEN' : 'TRYON_HIDE');
          if (isOpen) focusWidget();
        }
        if (e.data.type === 'TRYON_RELOADING' && fromWidget) {
          widgetReady = false;
          if (isOpen) armFallback();
        }
        if (e.data.type === 'TRYON_CLOSE' && fromWidget) {
          close(true);
        }
        if (e.data.type === 'TRYON_ADD_TO_CART' && e.data.payload && fromWidget) {
          if (!window.__tryonCartMessageBound) {
            tryonAddToCart(e.data.payload);
          }
          close(true);
        }
        if (e.data.type === 'TRYON_ADD_TO_WISHLIST' && e.data.payload) {
          console.log('[TryOn] Wishlist action:', e.data.payload.action || 'add', e.data.payload.productId);
        }
        if (e.data.type === 'TRYON_USER_ID' && e.data.user_id && iframe) {
          var base = iframe.getAttribute('data-tryon-src') || '';
          if (base) {
            var sep = base.indexOf('?') >= 0 ? '&' : '?';
            iframe.src = base + sep + 'user_id=' + encodeURIComponent(e.data.user_id);
          }
        }
      });
    })();
  </script>
</div>
{% endif %}

{% schema %}
{
  "name": "Try On",
  "target": "section",
  "javascript": "tryon-cart.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try On"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Padding top/bottom",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Padding left/right",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space above",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 16
    }
  ]
}
{% endschema %}
