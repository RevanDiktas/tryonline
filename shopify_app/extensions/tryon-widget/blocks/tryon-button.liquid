{% comment %}
  TryOn — "Try On" button app block for product pages.
  Renders a button that opens the TryOn widget in a modal iframe.
  On Add to Cart: calls Shopify /cart/add.js with the variant matching the selected size.
{% endcomment %}
{% liquid
  assign widget_base = 'https://tryonline.vercel.app'
  assign shop_domain = shop.permanent_domain
  assign product_id = product.handle
  assign variant = product.selected_or_first_available_variant
  assign variant_id = variant.id
  assign widget_url = widget_base | append: '/test-viewer.html?shop=' | append: shop_domain | append: '&product_id=' | append: product_id | append: '&variant_id=' | append: variant_id | append: '&open=1&v=3'
%}

<div class="tryon-app-block" {{ block.shopify_attributes }}>
  <style>
    .tryon-app-block { margin: 1rem 0; }
    .tryon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 24px;
      background: #0a0a0a;
      color: #fff;
      border: none;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.05em;
      cursor: pointer;
      border-radius: 6px;
      transition: opacity 0.2s;
    }
    .tryon-btn:hover { opacity: 0.9; }
  </style>

  <button type="button" class="tryon-btn" data-tryon-open aria-label="Try on with TryOn">
    {{ block.settings.button_label }}
  </button>

  <iframe
    id="tryon-frame-{{ block.id }}"
    src=""
    title="TryOn — Virtual try-on"
    data-tryon-src="{{ widget_url }}"
    loading="lazy"
    allowtransparency="true"
    style="display:none;position:fixed;inset:0;width:100%;height:100%;z-index:999999;border:none;background:transparent;"
  ></iframe>

  <script>
    (function() {
      var btn = document.querySelector('[data-tryon-open]');
      var iframe = document.getElementById('tryon-frame-{{ block.id }}');
      if (!btn || !iframe) return;
      var src = iframe.getAttribute('data-tryon-src');

      /* Size → Shopify variant ID map built from Liquid */
      var sizeVariantMap = {};
      {% for v in product.variants %}
        sizeVariantMap['{{ v.option1 | downcase | strip }}'] = {{ v.id }};
      {% endfor %}
      var fallbackVariantId = {{ variant_id }};

      btn.addEventListener('click', function() {
        iframe.src = src;
        iframe.style.display = 'block';
        document.body.style.overflow = 'hidden';
      });

      function close() {
        iframe.style.display = 'none';
        iframe.src = '';
        document.body.style.overflow = '';
      }

      function addToShopifyCart(varId, qty) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: varId, quantity: qty || 1 }] })
        })
        .then(function(r) {
          if (!r.ok) throw new Error('Cart add failed: ' + r.status);
          return r.json();
        })
        .then(function() {
          /* Refresh cart UI — works for most themes (Dawn, etc.) */
          if (typeof window.Shopify !== 'undefined' && typeof window.Shopify.onCartUpdate === 'function') {
            fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
              window.Shopify.onCartUpdate(cart);
            });
          }
          /* Update cart count bubble if present */
          fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
            var badges = document.querySelectorAll('.cart-count-bubble span, [data-cart-count]');
            badges.forEach(function(el) { el.textContent = cart.item_count; });
          });
        })
        .catch(function(err) { console.error('[TryOn] Add to cart error:', err); });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && iframe.style.display === 'block') close();
      });

      window.addEventListener('message', function(e) {
        if (!e.data) return;
        if (e.data.type === 'TRYON_CLOSE') {
          close();
        }
        if (e.data.type === 'TRYON_ADD_TO_CART') {
          var payload = e.data.payload || {};
          var size = (payload.size || '').toLowerCase().trim();
          var vid = sizeVariantMap[size] || fallbackVariantId;
          addToShopifyCart(vid, 1);
          close();
        }
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Try On",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try On"
    }
  ]
}
{% endschema %}
