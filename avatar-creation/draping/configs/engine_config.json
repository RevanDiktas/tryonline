{
  "engine": {
    "mode": "swift",
    "gpu_id": 0,
    "headless": true,
    "verbose": false
  },
  "solver": {
    "type": "XPBD",
    "substeps": 10,
    "iterations": 5,
    "dt": 0.016,
    "gravity": [0.0, -9.81, 0.0]
  },
  "collision": {
    "body_cloth": true,
    "self_collision": true,
    "collision_margin": 0.002,
    "friction": 0.3
  },
  "output": {
    "format": "obj",
    "frame_range": [0, 0],
    "export_normals": true,
    "export_uvs": true
  }
}
