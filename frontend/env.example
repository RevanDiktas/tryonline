# Tryon Frontend (Next.js) — Environment Variables
# ================================================
# For local dev copy to .env.local. For Vercel add these in Project → Settings → Environment Variables.

# Shopify embedded app (App Bridge) — Client ID from Partners for the app that loads in admin.
# Prefer this name on Vercel (distinct from Railway SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_ID_PILOT).
NEXT_PUBLIC_SHOPIFY_EMBEDDED_CLIENT_ID=ec47b40d60204a8d7cf80aa50e313d19
# Optional legacy alias (used only if NEXT_PUBLIC_SHOPIFY_EMBEDDED_CLIENT_ID is unset):
# NEXT_PUBLIC_SHOPIFY_CLIENT_ID=ec47b40d60204a8d7cf80aa50e313d19
