# Tryon Frontend (Next.js) — Environment Variables
# ================================================
# For local dev copy to .env.local. For Vercel add these in Project → Settings → Environment Variables.

# Shopify App — REQUIRED for embedded app (App Store check)
# Copy the exact value from: Dev Dashboard → Tryon → Settings → "Klant-ID" (Client ID).
# If this does not match the app in Partners, the "Controles ingesloten apps" check will fail.
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=ec47b40d60204a8d7cf80aa50e313d19
